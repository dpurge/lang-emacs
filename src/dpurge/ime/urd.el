(require 'quail)

(quail-define-package
  "dpurge-urd" "UTF-8" "urd<" t
  "Urdu input method using a simple transliteration scheme."
  nil t nil nil nil nil nil nil nil nil t)

(quail-define-rules
 ;; independent vowels and hamza forms
 ("A" "آ")
 ("a" "ا")
 ("a`" "أ")
 ("i`" "إ")
 ("w`" "ؤ")
 ("y`" "ئ")
 ("e`" "ۓ")
 ("'" "ء")

 ;; consonants
 ("bh" "بھ")
 ("ph" "پھ")
 ("th" "تھ")
 ("Th" "ٹھ")
 ("jh" "جھ")
 ("ch" "چھ")
 ("dh" "دھ")
 ("Dh" "ڈھ")
 ("rh" "ڑھ")
 ("kh" "خ")
 ("gh" "غ")
 ("sh" "ش")
 ("zh" "ژ")

 ("b" "ب")
 ("p" "پ")
 ("t" "ت")
 ("T" "ٹ")
 ("c" "ث")
 ("j" "ج")
 ("C" "چ")
 ("H" "ح")
 ("x" "خ")
 ("d" "د")
 ("D" "ڈ")
 ("z`" "ذ")
 ("r" "ر")
 ("R" "ڑ")
 ("z" "ز")
 ("J" "ژ")
 ("s" "س")
 ("S" "ش")
 ("s." "ص")
 ("d." "ض")
 ("t." "ط")
 ("z." "ظ")
 ("G" "ع")
 ("g" "غ")
 ("f" "ف")
 ("q" "ق")
 ("k" "ک")
 ("g`" "گ")
 ("l" "ل")
 ("m" "م")
 ("n" "ن")
 ("N" "ں")
 ("w" "و")
 ("h" "ہ")
 ("h`" "ھ")
 ("y" "ی")
 ("Y" "ے")

 ;; extra letters occasionally useful in Urdu-adjacent writing
 ("tt" "ٿ")
 ("dd" "ڐ")
 ("rr" "ڙ")

 ;; vowel marks and signs
 ("i" "ِ")
 ("u" "ُ")
 ("e" "َ")
 ("ii" "ً")
 ("~" "ّ")
 ("o" "ْ")
 ("^" "ٰ")
 ("_" "ـ")
 ("\\" "‌")

 ;; punctuation
 ("," "،")
 (";" "؛")
 ("?" "؟")
 ("<<" "«")
 (">>" "»")

 ;; digits
 ("0" "۰")
 ("1" "۱")
 ("2" "۲")
 ("3" "۳")
 ("4" "۴")
 ("5" "۵")
 ("6" "۶")
 ("7" "۷")
 ("8" "۸")
 ("9" "۹"))

(provide 'dpurge-urd)
